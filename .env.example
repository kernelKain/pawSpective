GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_ANALYSIS_FALLBACK_MODEL=gemini-3.1-flash-lite

PAWSPECTIVE_DEMO_MODE=true
PAWSPECTIVE_ALLOW_DEMO_FALLBACK=true
PAWSPECTIVE_CONTROLLED_DEMO_ENABLED=false
PAWSPECTIVE_DEMO_CACHE_DIRECTORY=demo_cache
PAWSPECTIVE_MEDIA_DIRECTORY=media
PAWSPECTIVE_MAX_VIDEO_DURATION_SECONDS=15
PAWSPECTIVE_MAX_UPLOAD_BYTES=31457280
PAWSPECTIVE_CORS_ORIGINS=http://localhost:3000
PAWSPECTIVE_JOBS_DIRECTORY=media/jobs
PAWSPECTIVE_JOB_DATABASE=media/jobs.sqlite3
PAWSPECTIVE_JOB_TTL_SECONDS=3600
PAWSPECTIVE_MAX_CONCURRENT_STORY_JOBS=1
PAWSPECTIVE_STORY_JOBS_PER_HOUR=5
PAWSPECTIVE_JOB_POLL_INTERVAL_MS=1500
PAWSPECTIVE_ANIMATION_ENABLED=true
PAWSPECTIVE_OMNI_VIDEO_MODEL=gemini-omni-flash-preview
PAWSPECTIVE_VEO_VIDEO_MODEL=veo-3.1-fast-generate-preview
PAWSPECTIVE_ANIMATION_TIMEOUT_SECONDS=420
PAWSPECTIVE_ALLOW_LOCAL_ANIMATION_FALLBACK=true

ELEVENLABS_API_KEY=
ELEVENLABS_DOG_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
